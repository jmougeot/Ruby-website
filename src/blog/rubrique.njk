---
pagination:
  data: collections.postCategories
  size: 1
  alias: category
permalink: "/blog/rubrique/{{ category | slugify }}/"
layout: layouts/base.njk
eleventyExcludeFromCollections: true
eleventyComputed:
  metaTitle: "{{ category }} — Le journal de Ruby"
  description: "Tous nos articles de la rubrique {{ category }} : analyses et méthodes de vente."
---
{% set posts = collections.posts | byCategory(category) %}
<div class="journal">
    <section class="container--wide rubrique-page">
        <header class="rubrique-head">
            <span class="label">Rubrique</span>
            <h1 class="rubrique-head__title">{{ category }}</h1>
            <p class="rubrique-head__count">{{ posts.length }} article{{ 's' if posts.length > 1 else '' }}</p>
        </header>
        <div class="post-grid post-grid--3">
            {% for post in posts %}{% include "partials/post-card.njk" %}{% endfor %}
        </div>
    </section>

    <section class="journal-cta">
        <div class="container--wide journal-cta__inner">
            <div>
                <h2 class="headline-medium journal-cta__title">Recevez nos analyses sur la vente.</h2>
                <p class="journal-cta__text">Les méthodes qui font vraiment bouger les taux de conversion, directement issues de l'analyse de milliers d'appels.</p>
            </div>
            <a href="/demo.html" class="btn btn--primary btn--large">Demander une démo</a>
        </div>
    </section>
</div>
