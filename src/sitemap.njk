---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    {% set staticUrls = ["/", "/ai.html", "/demo.html", "/privacy.html", "/terms.html", "/blog/"] %}
    {% for u in staticUrls %}
    <url><loc>{{ u | absoluteUrl(site.url) }}</loc></url>
    {% endfor %}
    {% for post in collections.posts %}
    <url>
        <loc>{{ post.url | absoluteUrl(site.url) }}</loc>
        <lastmod>{{ post.data.date | dateIso }}</lastmod>
    </url>
    {% endfor %}
    {% for cat in collections.postCategories %}
    <url><loc>{{ ('/blog/rubrique/' + (cat | slugify) + '/') | absoluteUrl(site.url) }}</loc></url>
    {% endfor %}
</urlset>
